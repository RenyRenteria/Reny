APP_NAME="Reny Renteria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production hardening (replace the local values above when deploying):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://renyrenteria.com
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true

APP_TIMEZONE=America/Panama
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reny
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
ADMIN_SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

ADMIN_CMS_ENABLED=true
# Private admin URL prefix. Leave blank to use the private default baked into config/admin.php.
# Set a unique secret here in production to rotate the path without a code deploy.
ADMIN_PATH=
RENY_QA_PASSWORD=
RENY_ALLOW_QA_FIXTURES=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

MUX_BASE_URL=https://api.mux.com
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_WEBHOOK_TOLERANCE_SECONDS=300
MUX_CORS_ORIGIN="${APP_URL}"
MUX_PLAYBACK_POLICY=public
MUX_VIDEO_QUALITY=basic

VIDEO_THUMBNAIL_FFMPEG_BINARY=ffmpeg
VIDEO_THUMBNAIL_TIMEOUT_SECONDS=30

VITE_APP_NAME="${APP_NAME}"
